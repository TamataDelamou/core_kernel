# ---- Application ----
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

# ---- PostgreSQL (Kernel Services — GSG ID) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gsg_id
DB_PASSWORD=change-me-in-secrets-manager
DB_DATABASE=gsg_id
DB_SSL=false

# ---- Redis (sessions, cache AppConfig, rate limiting distribué) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT / OIDC (GSG ID — KER-ID-01) ----
JWT_ACCESS_SECRET=replace-with-256-bit-secret-in-vault
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace-with-different-256-bit-secret-in-vault
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=https://id.gsg.africa
JWT_AUDIENCE=gsg-platform

# ---- MFA (KER-ID-04) ----
MFA_ISSUER_NAME=GSG ID
MFA_TOTP_WINDOW=1
# 32 octets (64 caractères hex) — générer avec : openssl rand -hex 32
MFA_ENCRYPTION_KEY_HEX=replace-with-64-hex-chars-generated-via-openssl-rand--hex-32

# ---- Rate limiting (OWASP — brute force / credential stuffing) ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=20

# ---- Event Bus (publication d'audit — KER-AUD-04, KER-EVT-01) ----
EVENT_BUS_STREAM_PREFIX=gsg.kernel.events

# ---- Transactional Outbox (résilience de l'Event Bus) ----
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=10

# ---- Supabase — pont d'identité (KER-ID-02) ----
# Modèle d'authentification de référence : chaque application GSG utilise Supabase Auth
# nativement (signInWithOtp/verifyOtp — SMS, WhatsApp via Twilio, Magic Link ou OTP email).
# GSG ID ne génère ni ne vérifie de code OTP lui-même : il vérifie la session Supabase déjà
# authentifiée par le produit, puis relie ou crée le profil GSG ID correspondant.
# Liste blanche stricte des URLs de projet Supabase reconnues (une par produit GSG),
# séparées par des virgules — condition anti-SSRF avant tout appel sortant vers un JWKS.
SUPABASE_ALLOWED_PROJECT_URLS=https://xxxxxxxxxxxx.supabase.co,https://yyyyyyyyyyyy.supabase.co
# Cache JWKS local (JoseSupabaseSessionVerifier) — TTL court, timeout réseau, et cooldown
# anti-martèlement pour les rafraîchissements forcés déclenchés par un échec de vérification.
# Valeurs par défaut raisonnables ci-dessous ; à ajuster seulement si nécessaire.
SUPABASE_JWKS_CACHE_TTL_SECONDS=300
SUPABASE_JWKS_FETCH_TIMEOUT_MS=4000
SUPABASE_JWKS_FORCED_REFRESH_COOLDOWN_SECONDS=10

# ---- Consommateur Redis Streams — module Audit (KER-AUD, résilience de l'Event Bus) ----
AUDIT_CONSUMER_GROUP=audit-consumers
AUDIT_CONSUMER_BATCH_SIZE=10
AUDIT_CONSUMER_BLOCK_MS=5000
AUDIT_CONSUMER_MAX_DELIVERIES=5
AUDIT_CONSUMER_CLAIM_IDLE_MS=30000
AUDIT_CONSUMER_CLAIM_INTERVAL_MS=15000

# ---- Compteur de villes rattachées (KER-ADM-04, garde-fou referential-engine) ----
# Consommateur Redis Streams distinct de celui d'Audit — même flux partagé, groupe propre,
# filtre sur referential.ville.created/moved uniquement. Aucune Dead-Letter Queue ici : cette
# table est un cache local eventually-consistent, jamais une source de vérité (voir README).
REF_ENGINE_VILLES_CONSUMER_GROUP=referential-engine-villes-consumers
REF_ENGINE_VILLES_CONSUMER_BATCH_SIZE=20
REF_ENGINE_VILLES_CONSUMER_BLOCK_MS=5000
REF_ENGINE_VILLES_CONSUMER_CLAIM_IDLE_MS=30000
REF_ENGINE_VILLES_CONSUMER_CLAIM_INTERVAL_MS=15000
